# --- Runtime state ---
# Exclude .tst/ runtime state, but never .tst/rules/ or .tst/memory/
# (meant to be shared, per AGENTS.md §8).
.tst/*
!.tst/rules/
!.tst/rules/**
!.tst/memory/
!.tst/memory/**
!.tst/context/
!.tst/context/**

# --- Build artifacts ---
target/
build/
ui/build-android/
dist/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
ui/e2e/.runtime.json
ui/e2e/.daemon.pid
ui/test-results/
ui/playwright-report/
ui/blob-report/

# --- Secrets ---
.env
.env.local
credentials.json
# Runtime keychain artifacts (DB dumps, export files) — not source code
*.keychain
*.keychain-db
/secrets/

# --- Stray development artifacts ---
# Anchored to the repo root on purpose. Unanchored, `darwin.py` matched
# mcp/tst-cu-mcp/src/tst_cu_mcp/backends/darwin.py — a real source file — and
# silently excluded it from staging, which would have shipped a package that
# cannot import on macOS.
/darwin.py
files_*.zip
# Sideload APK copies and reference screenshots parked at the root during
# sessions; the build outputs live under android/app/build/outputs/.
/*.apk
/*.png
/*.jpg

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- Editor ---
*.swp
*.swo
*~
.vscode/
.idea/