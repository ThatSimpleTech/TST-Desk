{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "session-windows",
  "description": "Permissions for per-session viewer windows (TD-4703).",
  "windows": ["session-*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "x-apple.systemsettings:*"
        },
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    }
  ]
}
