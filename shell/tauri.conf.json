{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TST Desk",
  "version": "0.1.0",
  "identifier": "com.thatsimpletech.tstdesk",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../core && uv run python scripts/build_sidecar.py --if-missing && cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../core && uv run python scripts/build_sidecar.py && cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TST Desk",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tstd"],
    "macOS": {
      "signingIdentity": "tst-desk-dev",
      "entitlements": "./macos-entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}