<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundled PyInstaller daemon extracts libpython at runtime; that
	     dylib keeps Python.org's build signature (foreign Team ID). Library
	     validation would block it once we sign with a real identity. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Hold-to-talk (TD-4701): getUserMedia audio only while the control is held. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
