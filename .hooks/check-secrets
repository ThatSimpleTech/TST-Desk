#!/usr/bin/env bash
# Pre-commit hook: reject staged files containing credential-like patterns.
# Receives filenames as command-line arguments (pre-commit convention for script hooks).
set -euo pipefail

# Patterns that look like secrets (case-insensitive value checks)
API_KEY_PATTERNS=(
  'sk-[a-zA-Z0-9]{20,}'            # OpenAI / OpenRouter
  'github_pat_[a-zA-Z0-9_]{36,}'   # GitHub fine-grained PAT
  'ghp_[a-zA-Z0-9]{36,}'           # GitHub classic PAT
  'gho_[a-zA-Z0-9]{36,}'           # GitHub OAuth
  'AKIA[0-9A-Z]{16}'               # AWS access key
  '-----BEGIN\s+(RSA |EC |DSA |OPENSSH )?PRIVATE KEY'  # Private key
  'xox[baprs]-[0-9a-zA-Z-]{10,}'  # Slack token
  'hf_[a-zA-Z]{20,}'               # HuggingFace token
)

# Credential-related field names (from tst-cua policy.py)
CREDENTIAL_FIELD_PATTERN='\b(password|passwd|pwd|passphrase|secret|api[_-]?key|token|otp|2fa|mfa|cvv|cvc|security[_\s]?code|ssn|social[_\s]?security|routing|iban)\b'

exit_code=0

for file in "$@"; do
  [ -z "$file" ] && continue
  [ ! -f "$file" ] && continue

  # Skip binary files
  if [[ "$(file --mime-encoding "$file" 2>/dev/null)" == *binary* ]]; then
    continue
  fi

  # Skip hook scripts themselves (they contain the regex patterns we search for)
  if [[ "$file" == .hooks/* ]]; then
    continue
  fi

  # Skip auto-generated lock files (hashes and URLs are not credentials)
  if [[ "$file" == *uv.lock ]] || [[ "$file" == *Cargo.lock ]] || [[ "$file" == *package-lock.json ]]; then
    continue
  fi

  # Track whether this file is a test file (less strict for credential field names)
  _is_test=false
  [[ "$file" == *test* ]] || [[ "$file" == *fixture* ]] || [[ "$file" == *scripts/generate_* ]] && _is_test=true

  # Check for credential-like field assignments: key = "value" or "key": "value"
  # The credential word is the KEY (left of = or :), followed by a quoted string value.
  # Skip type annotations and lines with explicit skip markers.
  # Test files skip this check entirely (test fixtures use credential field names).
  if [ "$_is_test" != "true" ]; then
    if grep -InE '('"$(echo "$CREDENTIAL_FIELD_PATTERN" | sed 's/\\b//g')"')[:=]\s*["'"'"']' "$file" 2>/dev/null | grep -vE '^\s*#' | grep -vE '^\s*//' | grep -vE 'tst-secret-ok' | grep -vE ':\s*(str|int|bool|float|bytes|Any|Optional|Literal|Union|list|dict|set|tuple|None)\b'; then
      echo "⚠️  $file: contains credential-like field assignment"
      exit_code=1
    fi
  fi

  # Check for API key patterns
  for pattern in "${API_KEY_PATTERNS[@]}"; do
    if grep -InE "$pattern" "$file" 2>/dev/null | grep -vE '^\s*#' | grep -vE '^\s*//' | grep -vE 'tst-secret-ok'; then
      echo "⚠️  $file: contains a value matching $pattern"
      exit_code=1
    fi
  done
done

if [ "$exit_code" -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked: potential secrets detected in staged files."
  echo "   If these are false positives, use 'git commit --no-verify' to skip."
  echo "   Review the .gitignore and ensure no secret files are tracked."
fi

exit "$exit_code"